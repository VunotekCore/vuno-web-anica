---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Header from "../components/Header.astro";
import ContactForm from "../components/Contact-form.astro";
import Footer from "../components/Footer.astro";

const seoConfig = {
    title: "Contacto | Anica Soluciones Integrales",
    description:
        "Contáctanos para cotizar tus proyectos de diseño gráfico, impresión, desarrollo web y muebles comerciales. Estamos listos para ayudarte.",
    keywords:
        "contacto Anica, cotización diseño Nicaragua, presupuesto impresión, consultoría web Nicaragua",
};
---

<DefaultLayout {...seoConfig}>
    <Header />

    <main class="w-full">
        <!-- Hero Section -->
        <section
            class="w-full py-16 md:py-24 bg-gradient-to-br from-gray-50 to-white"
        >
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h1
                        class="text-4xl md:text-5xl font-bold text-neutral mb-4 font-lobster"
                    >
                        Contáctanos
                    </h1>
                    <p
                        class="text-xl text-neutral-light font-montserrat max-w-3xl mx-auto"
                    >
                        ¿Tienes un proyecto en mente? <span
                            class="text-primary font-semibold">Hablemos</span
                        >. Estamos listos para <span
                            class="text-primary font-semibold">ayudarte</span
                        > a hacer realidad tus ideas.
                    </p>
                </div>
            </div>
        </section>

        <!-- Contact Form Section -->
        <section class="w-full py-2 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <ContactForm />

                <!-- Contact Information -->
                <div class="mt-16 grid gap-8 md:grid-cols-3">
                    <div
                        class="flex flex-col items-center gap-4 rounded-lg border-2 border-gray-200 hover:border-primary bg-gray-50 p-6 transition-all duration-300 hover:shadow-lg"
                    >
                        <div
                            class="rounded-full border-2 border-primary bg-primary/10 p-4"
                        >
                            <svg
                                class="w-8 h-8 text-primary"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="font-bold text-xl text-neutral font-lobster">
                            Email
                        </h3>
                        <a
                            href="mailto:info@anicasolucionesintegrales.com"
                            class="text-primary hover:text-primary-dark transition-colors font-montserrat"
                        >
                            info@anicasolucionesintegrales.com
                        </a>
                    </div>

                    <div
                        class="flex flex-col items-center gap-4 rounded-lg border-2 border-gray-200 hover:border-secondary bg-gray-50 p-6 transition-all duration-300 hover:shadow-lg"
                    >
                        <div
                            class="rounded-full border-2 border-secondary bg-secondary/10 p-4"
                        >
                            <svg
                                class="w-8 h-8 text-secondary"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="font-bold text-xl text-neutral font-lobster">
                            Teléfono
                        </h3>
                        <a
                            href="tel:+50577776363"
                            class="text-secondary hover:text-secondary-dark transition-colors font-montserrat"
                        >
                            +505 7777-6363
                        </a>
                    </div>

                    <div
                        id="location-card"
                        class="flex flex-col items-center gap-4 rounded-lg border-2 border-gray-200 hover:border-accent bg-gray-50 p-6 transition-all duration-300 hover:shadow-lg cursor-pointer hover:scale-[1.02] group"
                    >
                        <div
                            class="rounded-full border-2 border-accent bg-accent/10 p-4 group-hover:bg-accent group-hover:text-white transition-colors"
                        >
                            <svg
                                class="w-8 h-8 text-accent group-hover:text-white transition-colors"
                                fill="currentColor"
                                viewBox="0 0 64 64"
                            >
                                <use href="/assets/sprite.svg#location"></use>
                            </svg>
                        </div>
                        <h3 class="font-bold text-xl text-neutral font-lobster">
                            Ubicación
                        </h3>
                        <p
                            class="text-center text-neutral-light font-montserrat"
                        >
                            Managua, Nicaragua
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <Footer />

    <!-- Map Modal -->
    <!-- centrar este dialog modal -->
    <dialog
        id="map-modal"
        class="backdrop:bg-black/50 overflow-hidden rounded-xl p-0 shadow-2xl backdrop:backdrop-blur-sm m-auto fixed inset-0 max-w-[90vw] max-h-[90vh]"
    >
        <div class="bg-white relative h-[450px] w-[600px] max-w-full">
            <button
                id="close-map-btn"
                class="text-neutral hover:text-primary absolute right-4 top-4 z-10 rounded-full bg-white p-2 shadow-md transition-colors"
            >
                <svg
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"></path></svg
                >
            </button>
            <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d445.0827411115972!2d-86.29618682380324!3d12.139341122065856!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f71579323530715%3A0x5b4551843b43a878!2sANICA%20SOLUCIONES%20INTEGRALES!5e0!3m2!1sen!2sni!4v1770654105190!5m2!1sen!2sni"
                width="600"
                height="450"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </dialog>

    <script>
        const mapModal = /** @type {any} */ (
            document.getElementById("map-modal")
        );
        const locationCard = document.getElementById("location-card");
        const closeMapBtn = document.getElementById("close-map-btn");

        locationCard?.addEventListener("click", () => {
            mapModal?.showModal();
        });

        closeMapBtn?.addEventListener("click", () => {
            mapModal?.close();
        });

        mapModal?.addEventListener("click", (/** @type {any} */ e) => {
            const dialogDimensions = mapModal.getBoundingClientRect();
            if (
                e.clientX < dialogDimensions.left ||
                e.clientX > dialogDimensions.right ||
                e.clientY < dialogDimensions.top ||
                e.clientY > dialogDimensions.bottom
            ) {
                mapModal.close();
            }
        });
    </script>
</DefaultLayout>
