---
// Seasonal Promotion Component
// Positioned between Hero and Services sections
---

<section
    class="w-full py-12 md:py-16 bg-gradient-to-br from-primary via-[#FF6B35] to-[#FF8C42] relative overflow-hidden"
>
    <!-- Background decorative elements -->
    <div class="absolute inset-0 opacity-10">
        <div
            class="absolute top-10 left-10 w-32 h-32 bg-white rounded-full blur-3xl"
        >
        </div>
        <div
            class="absolute bottom-10 right-10 w-40 h-40 bg-white rounded-full blur-3xl"
        >
        </div>
        <div
            class="absolute top-1/2 left-1/3 w-24 h-24 bg-white rounded-full blur-2xl"
        >
        </div>
    </div>

    <!-- Animated geometric shapes -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div
            class="absolute top-20 left-[10%] w-16 h-16 border-4 border-white/20 rotate-12 animate-float"
        >
        </div>
        <div
            class="absolute bottom-20 right-[15%] w-20 h-20 border-4 border-white/20 rotate-45 animate-float-delayed"
        >
        </div>
        <div
            class="absolute top-1/3 right-[25%] w-12 h-12 bg-white/10 rounded-full animate-pulse"
        >
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div
            class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center"
        >
            <!-- Left: Promotional Content -->
            <div
                class="text-center md:text-left space-y-6 animate-slide-in-left"
            >
                <!-- Badge -->
                <div
                    class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full border border-white/30"
                >
                    <svg
                        class="w-5 h-5 text-white animate-pulse"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                        ></path>
                    </svg>
                    <span
                        class="text-white font-semibold text-sm font-montserrat"
                        >Oferta Especial</span
                    >
                </div>

                <!-- Main Heading -->
                <h2
                    class="text-3xl md:text-5xl font-bold text-white font-lobster leading-tight"
                >
                    Promoción de<br />
                    <span class="text-6xl md:text-7xl">Temporada</span>
                </h2>

                <!-- Description -->
                <p
                    class="text-lg md:text-xl text-white/90 font-montserrat max-w-lg mx-auto md:mx-0"
                >
                    Aprovecha descuentos especiales en nuestros servicios de
                    diseño, impresión y rotulación. ¡Tiempo limitado!
                </p>

                <!-- Discount Badge -->
                <div
                    class="flex items-center justify-center md:justify-start gap-4"
                >
                    <div
                        class="bg-white rounded-2xl px-6 py-4 shadow-2xl transform hover:scale-105 transition-transform duration-300"
                    >
                        <p
                            class="text-sm text-neutral-light font-montserrat mb-1"
                        >
                            Hasta
                        </p>
                        <p
                            class="text-4xl md:text-5xl font-bold text-primary font-lobster"
                        >
                            20%
                        </p>
                        <p class="text-sm text-neutral-light font-montserrat">
                            de descuento
                        </p>
                    </div>
                </div>

                <!-- CTA Button -->
                <div class="pt-4">
                    <a
                        href="/contacto"
                        class="inline-flex items-center gap-3 bg-white text-primary hover:bg-gray-50 font-bold text-lg px-8 py-4 rounded-xl transition-all duration-300 transform hover:scale-105 hover:shadow-2xl font-montserrat shadow-xl group"
                    >
                        Solicitar Cotización
                        <svg
                            class="w-5 h-5 transform group-hover:translate-x-1 transition-transform"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Right: Promotional Image -->
            <div class="relative animate-slide-in-right">
                <div
                    class="relative rounded-2xl overflow-hidden shadow-2xl transform hover:scale-105 transition-all duration-500"
                >
                    <!-- Placeholder for promotional image -->
                    <div
                        class="aspect-[4/3] bg-gradient-to-br from-white/20 to-white/5 backdrop-blur-sm border-2 border-white/30 rounded-2xl flex items-center justify-center"
                    >
                        <div class="text-center p-8">
                            <svg
                                class="w-24 h-24 mx-auto mb-4 text-white/80"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"
                                ></path>
                            </svg>
                            <p class="text-white/70 font-montserrat text-sm">
                                Imagen promocional
                            </p>
                        </div>
                    </div>

                    <!-- Sparkle effects -->
                    <div
                        class="absolute top-4 right-4 w-8 h-8 text-white/60 animate-ping"
                    >
                        <svg fill="currentColor" viewBox="0 0 24 24">
                            <path
                                d="M12 2l2.4 7.2H22l-6 4.8 2.4 7.2L12 16.8 5.6 21.2 8 14 2 9.2h7.6z"
                            ></path>
                        </svg>
                    </div>
                    <div
                        class="absolute bottom-4 left-4 w-6 h-6 text-white/60 animate-ping"
                        style="animation-delay: 0.5s"
                    >
                        <svg fill="currentColor" viewBox="0 0 24 24">
                            <path
                                d="M12 2l2.4 7.2H22l-6 4.8 2.4 7.2L12 16.8 5.6 21.2 8 14 2 9.2h7.6z"
                            ></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Float animation for geometric shapes */
    @keyframes float {
        0%,
        100% {
            transform: translateY(0) rotate(12deg);
        }
        50% {
            transform: translateY(-20px) rotate(12deg);
        }
    }

    @keyframes float-delayed {
        0%,
        100% {
            transform: translateY(0) rotate(45deg);
        }
        50% {
            transform: translateY(-15px) rotate(45deg);
        }
    }

    .animate-float {
        animation: float 6s ease-in-out infinite;
    }

    .animate-float-delayed {
        animation: float-delayed 8s ease-in-out infinite;
    }

    /* Slide in animations */
    @keyframes slide-in-left {
        from {
            opacity: 0;
            transform: translateX(-30px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes slide-in-right {
        from {
            opacity: 0;
            transform: translateX(30px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .animate-slide-in-left {
        animation: slide-in-left 0.8s ease-out;
    }

    .animate-slide-in-right {
        animation: slide-in-right 0.8s ease-out 0.2s both;
    }
</style>
