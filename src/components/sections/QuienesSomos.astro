---
interface Props {
  content?: string;
}

const { content } = Astro.props;
// separar en dos partes el contenido usando como separador <!--more-->
const mainContent = content
  ? content.split("<!--more-->").length > 1
    ? content.split("<!--more-->")[1]
    : content
  : "<p>Contenido no disponible</p>";
---

<article class="prose prose-lg max-w-none lg:prose-xl">
  <div set:html={mainContent} />
  <style is:global>
    article ul {
      list-style-type: disc !important;
      padding-left: 1.5em;
    }
    article li {
      list-style-type: disc !important;
    }
    article h4 {
      font-family: "Lobster", cursive !important;
      font-size: 1.3rem !important;
    }
    p {
      text-align: justify;
    }
  </style>
</article>
